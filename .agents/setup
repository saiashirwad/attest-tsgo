#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if ! command -v node >/dev/null || ! command -v npm >/dev/null; then
  echo "attest-tsgo development requires Node.js 24+ and npm in the orb" >&2
  exit 1
fi

node_major="$(node -p 'Number(process.versions.node.split(".")[0])')"
if (( node_major < 24 )); then
  echo "attest-tsgo development requires Node.js 24+ (found $(node --version))" >&2
  exit 1
fi

echo "Installing locked npm dependencies..."
time npm ci --no-audit --no-fund

echo "Building attest-tsgo..."
time npm run build
