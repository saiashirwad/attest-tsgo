{
  "name": "@texoport/attest",
  "version": "0.1.0",
  "description": "Experimental type assertions backed by native TypeScript 7",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/saiashirwad/attest-tsgo.git" },
  "bugs": { "url": "https://github.com/saiashirwad/attest-tsgo/issues" },
  "homepage": "https://github.com/saiashirwad/attest-tsgo#readme",
  "keywords": ["typescript", "assertions", "type-testing", "tsgo"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "bin": { "attest-tsgo": "./dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && tsc --project test/tsconfig.json && tsc --project test/fixtures/typed.tsconfig.json && node --test test/*.test.ts test/package.test.mjs",
    "test:package": "node --test test/package.test.mjs"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
